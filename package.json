{
  "name": "@local/dsh-deliberate-preset",
  "version": "1.4.5",
  "private": true,
  "description": "DeepSeek Harness 权衡模式：先评估代价，再分块执行；假设账本 + 状态触发的止损，另带 19 个行为用例评测。",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dexter-cpp/dsh-deliberate-preset.git"
  },
  "homepage": "https://github.com/Dexter-cpp/dsh-deliberate-preset#readme",
  "bugs": {
    "url": "https://github.com/Dexter-cpp/dsh-deliberate-preset/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-preset",
    "deliberate",
    "prompt-engineering"
  ],
  "scripts": {
    "test": "node --test loop-guard.test.cjs memory.test.cjs parity.test.cjs",
    "parity": "node sync-runtime.cjs --check",
    "eval:static": "node evaluate.cjs --static",
    "eval:self-test": "node evaluate.cjs --self-test"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "EVALUATION.md",
    "MIGRATION.md",
    "memory.cjs",
    "loop-guard.cjs",
    "state-bus.cjs",
    "ledger.cjs",
    "runtime-parity.json",
    "loop-guard.test.cjs",
    "memory.test.cjs",
    "parity.test.cjs",
    "sync-runtime.cjs",
    "evaluate.cjs",
    "evaluate-answerer.cjs"
  ]
}
